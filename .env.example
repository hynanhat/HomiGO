# Copy this file to .env and replace every change-me value before running locally.
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_NAME=batdongsan
DB_USER=homigo
DB_PASSWORD=change-me-database-password

# Use a random secret of at least 32 bytes. Never commit the real value.
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-bytes
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Use a separate random secret in production. Local development may reuse JWT_SECRET.
ANALYTICS_VIEWER_HASH_SECRET=change-me-to-another-random-secret-with-at-least-32-bytes
APP_BUSINESS_ZONE=Asia/Ho_Chi_Minh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict
HTTP_PORT=80
DB_PORT_FORWARD=3306

# SePay Sandbox seller-upgrade settings. Rotate any secret exposed in chat.
# Never commit actual merchant credentials.
SELLER_UPGRADE_PRICE=99000
SELLER_UPGRADE_PENDING_MINUTES=15
SEPAY_MERCHANT_ID=change-me-sandbox-merchant-id
SEPAY_SECRET_KEY=change-me-rotated-sandbox-secret
SEPAY_ENVIRONMENT=sandbox
SEPAY_CHECKOUT_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_FRONTEND_BASE_URL=http://localhost:5173

# Gemini Auth API key. Keep disabled until a server-only key is configured.
# Never use this key in VITE_* variables or frontend source code.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_VERSION=v1
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_ATTEMPTS=2
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_THINKING_LEVEL=minimal
GEMINI_RESERVATION_LEASE_SECONDS=90
