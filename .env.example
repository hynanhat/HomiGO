# Copy this file to .env and replace every change-me value before starting Docker.
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_NAME=batdongsan
DB_USER=homigo
DB_PASSWORD=change-me-database-password

# Use a random secret of at least 32 bytes. Never commit the real value.
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-bytes
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
